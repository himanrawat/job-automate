# Environment Variables for Himanshu's Job Automation
# Copy this file to .env and fill in your actual API keys

# OpenAI API Key (Required for content generation)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Apify API Token (Required for job scraping)
# Get from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# Google Sheets API Credentials (Required for tracking)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_PROJECT_ID=your_google_project_id
GOOGLE_CLIENT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----"
GOOGLE_PRIVATE_KEY_ID=your_private_key_id
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_X509_CERT_URL=your_client_cert_url
GOOGLE_UNIVERSE_DOMAIN=googleapis.com

# GitHub Token (Required for document storage)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
